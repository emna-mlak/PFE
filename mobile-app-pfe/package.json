{
  "name": "mobile-app-pfe",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --lan",
    "start:mobile": "bash scripts/start-mobile.sh",
    "start:mobile:stable": "bash scripts/start-mobile-stable.sh",
    "start:mobile:clean": "bash scripts/start-mobile.sh --clear",
    "start:lan": "expo start --lan",
    "start:lan:clean": "expo start --lan --clear",
    "start:localhost": "expo start --localhost --clear",
    "start:usb-android": "bash scripts/start-usb-android.sh",
    "start:usb-android:stable": "bash scripts/start-usb-android-stable.sh",
    "start:tunnel": "expo start --tunnel --clear",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android --clean",
    "build:android:debug": "expo run:android --variant debug --no-bundler",
    "build:android:release": "cd android && ./gradlew assembleRelease",
    "build:android:install": "expo run:android --device",
    "install:android:release": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "build:android:phone": "bash scripts/build-install-android.sh",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.96.1",
    "convex": "^1.34.1",
    "expo": "~54.0.34",
    "expo-av": "~16.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.22",
    "expo-image-picker": "~17.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.72.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "^0.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
