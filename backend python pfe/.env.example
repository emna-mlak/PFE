# Voice provider: keep local for Raspberry Pi offline mode
VOICE_STT_PROVIDER=local
VOICE_STRICT_OFFLINE=true

# If provider=local (recommended for privacy)
# Pi offline: run once with Internet: python scripts/download_whisper_model.py --model base
VOICE_LOCAL_MODEL=base
VOICE_WHISPER_DOWNLOAD_ROOT=models/whisper
VOICE_WHISPER_LOCAL_FILES_ONLY=1
VOICE_LOCAL_DEVICE=cpu
VOICE_LOCAL_COMPUTE_TYPE=int8
VOICE_LOCAL_LANGUAGE=fr
# Optional: load Whisper at API startup (slower boot, faster 1st /api/voice-command)
# VOICE_WHISPER_PRELOAD=1

# Optional runtime settings
YOLO_WEIGHTS=models/best.pt
OUTPUTS_DIR=outputs
PADDLE_OCR_LANG=eng
# Pi (aarch64): Python 3.12/3.11 + paddleocr<3 + paddlepaddle==2.6.2 (PAS Python 3.13).
# Debian Trixie : bash scripts/install_pi_venv.sh  (uv installe Python 3.12 si absent)
# PADDLE_OCR_LITE=1
# PADDLE_OCR_MOBILE=1
# PADDLE_ENABLE_MKLDNN=0
# PADDLE_TEXT_DET_MODEL=PP-OCRv5_mobile_det
# PADDLE_TEXT_REC_MODEL=en_PP-OCRv5_mobile_rec
MIN_SHARPNESS_THRESHOLD=0
YOLO_CONF_THRESHOLD=0.25
# Mac / dev : 1280 + augment. Pi (aarch64) : défaut auto 640 + augment off si non définis.
YOLO_INFER_IMGSZ=1280
YOLO_AUGMENT=true
# Sur la Pi, forcer explicitement si besoin :
# YOLO_INFER_IMGSZ=640
# YOLO_AUGMENT=false

# Raspberry Pi camera loop (scripts/run_pi_camera_loop.py)
# Pi 5 + Camera Module : utiliser picamera2 (OpenCV seul → « OpenCV camera read failed »).
PI_CAMERA_BACKEND=picamera2

# Dashboard MJPEG : sur Pi Trixie + venv Paddle 3.12, Picamera2 = python3 système → sidecar :8001.
# Laisser PI_CAMERA_MJPEG=0 sur l'API FastAPI (:8000) et activer terrain-camera-mjpeg.service.
PI_CAMERA_MJPEG=0
# PI_CAMERA_MJPEG_FPS=12
# PI_CAMERA_MJPEG_WIDTH=1280
# PI_CAMERA_MJPEG_HEIGHT=720
# PI_CAMERA_MJPEG_JPEG_QUALITY=85
# Après Picamera2.start(), pause avant la 1re capture (stabilité).
# PI_CAMERA_MJPEG_START_DELAY_SEC=1.5
# Timeout du préchauffage au démarrage API (lifespan) en secondes.
# PI_CAMERA_MJPEG_WARMUP_SEC=90
# Bridge vision (scripts/run_remote_ocr_bridge.py --input backend-mjpeg) lit ce flux sans 2e Picamera2.
# BACKEND_MJPEG_URL=http://127.0.0.1:8000/camera/mjpeg

# Convex local HTTP bridge (same Raspberry Pi)
CONVEX_VEHICLE_HTTP_URL=http://127.0.0.1:3211/vehicleLookup
CONVEX_VEHICLE_HTTP_SECRET=replace_with_local_shared_secret
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=replace_with_local_admin_key
ALERTS_PUBLISH_SECRET=replace_with_local_shared_secret
