# WebSocket FastAPI /alerts — une seule stratégie active à la fois.

# --- A) Chrome + http://localhost:8081 — proxies locaux (sinon WS 1006 / caméra noire)
# Un terminal : npm run proxy:all   (alertes :8765 + caméra :8780)
# Ou seulement alertes : npm run proxy:alerts
# Optionnel : ALERTS_UPSTREAM=ws://IP_PI:8000/alerts npm run proxy:alerts
# Si l’UI web est ouverte via l’IP LAN du Mac (:8081), l’app remplace 127.0.0.1 par cet hôte automatiquement.
# EXPO_PUBLIC_WS_URL=ws://127.0.0.1:8765

# --- B) Direct vers la Raspberry (souvent OK avec Firefox / même sous-réseau)
# EXPO_PUBLIC_BACKEND_HOST=192.168.x.x

# --- C) URL WebSocket complète
# EXPO_PUBLIC_WS_URL=ws://192.168.x.x:8000/alerts

EXPO_PUBLIC_WS_URL=
EXPO_PUBLIC_BACKEND_HOST=
EXPO_PUBLIC_API_PORT=8000

# Caméra MJPEG (Pi : PI_CAMERA_MJPEG=1)
# --- Chrome + localhost : Private Network Access → lancer aussi :
#     npm run proxy:all   (recommandé : alertes + caméra)
#     ou : npm run proxy:camera
#     (défaut upstream http://10.42.0.1:8000/camera/mjpeg ; surcharger avec CAMERA_UPSTREAM=...)
# EXPO_PUBLIC_CAMERA_PROXY_URL=http://127.0.0.1:8780/camera/mjpeg
# Par défaut sans proxy : `http://<BACKEND_HOST>:<API_PORT>/camera/mjpeg`
# EXPO_PUBLIC_CAMERA_USE_BACKEND_MJPEG=0
# Flux explicite (prioritaire) :
EXPO_PUBLIC_CAMERA_STREAM_URL=

# Sans .env : http://localhost:8081/?backend=IP_PI

# --- D) Tablette Android en terrain (APK, sans Mac) — voir DEMARRAGE_TABLETTE.md
# EXPO_PUBLIC_BACKEND_HOST=10.42.0.1
# EXPO_PUBLIC_API_PORT=8000
# EXPO_PUBLIC_WS_URL=                    (vide → ws://10.42.0.1:8000/alerts)
# EXPO_PUBLIC_CAMERA_PROXY_URL=          (vide → http://10.42.0.1:8000/camera/mjpeg)
# Build : npx eas build --platform android --profile preview
